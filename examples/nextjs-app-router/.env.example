# Required. Copy from "Access Token" in the MuseRank Webhook integration dialog.
MUSERANK_WEBHOOK_TOKEN=replace-me-min-10-chars

# Required if you turned on HMAC signing in MuseRank. Copy the `whsec_…`
# value shown ONCE at Connect / Rotate. To survive a rotation without
# dropping in-flight requests, comma-separate two values: the new
# secret first, the previous one second.
#
#   MUSERANK_SIGNING_SECRET=whsec_new_one,whsec_previous_one
MUSERANK_SIGNING_SECRET=whsec_replace-me
