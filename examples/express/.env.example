# Required. The Access Token you saved when configuring the webhook in MuseRank.
MUSERANK_WEBHOOK_TOKEN=replace-me-min-10-chars

# Required if you turned on HMAC signing. Comma-separate two values
# during a rotation window so both old and new senders verify.
MUSERANK_SIGNING_SECRET=whsec_replace-me

# Optional — defaults to 3000.
PORT=3000
