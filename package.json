{
  "name": "@muserank/webhook-sdk",
  "version": "3.0.0",
  "description": "SDK for receiving MuseRank webhook events in your application",
  "packageManager": "bun@1.2.14",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.mjs",
      "require": "./dist/web.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.ts",
      "import": "./dist/nextjs.mjs",
      "require": "./dist/nextjs.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.mjs",
      "require": "./dist/express.js"
    },
    "./payload.schema.json": "./payload.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "payload.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/web.ts src/nextjs.ts src/express.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/web.ts src/nextjs.ts src/express.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "schema:check": "node scripts/check-schema-fixtures.mjs",
    "lint": "bun run typecheck && bun run schema:check",
    "test:run": "vitest --run",
    "test": "vitest",
    "check": "bun run lint && bun run test:run && bun run build",
    "pack:check": "npm pack --dry-run --cache ./.npm-cache",
    "prepublishOnly": "bun run check"
  },
  "keywords": [
    "muserank",
    "webhook",
    "cms",
    "content",
    "seo",
    "nextjs",
    "express",
    "remix",
    "astro",
    "sveltekit",
    "cloudflare-workers"
  ],
  "author": "MuseRank",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuseRank/webhook-sdk.git"
  },
  "homepage": "https://github.com/MuseRank/webhook-sdk#readme",
  "bugs": {
    "url": "https://github.com/MuseRank/webhook-sdk/issues"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.1",
    "expect-type": "1.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "next": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
